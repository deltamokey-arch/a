    CONFIG.AUTO_ADD_ENABLED = not CONFIG.AUTO_ADD_ENABLED
    if CONFIG.AUTO_ADD_ENABLED then
        autoAddToggle.BackgroundColor3 = Color3.fromRGB(60, 120, 60)
        autoAddToggle.Text = '🟢 AUTO ADD ON'
        ats.Color = Color3.fromRGB(100, 255, 100)
        
        local minVal = tonumber(minBox.Text) or 1
        local maxVal = tonumber(maxBox.Text) or 6
        CONFIG.AUTO_ADD_MIN = math.clamp(minVal, 1, 20)
        CONFIG.AUTO_ADD_MAX = math.clamp(maxVal, CONFIG.AUTO_ADD_MIN, 20)
        CONFIG.AUTO_ADD_INTERVAL = tonumber(intervalBox.Text) or 1
        
        if mockState.autoAddThread then
            task.cancel(mockState.autoAddThread)
        end
        
    mockState.autoAddThread = task.spawn(function()
            while CONFIG.AUTO_ADD_ENABLED do
                task.wait(CONFIG.AUTO_ADD_INTERVAL + getSmartDelay())
                if mockState.active and not mockState.autoAddRunning and mockState.trade.current_stage ~= 'confirmation' then
                    mockState.autoAddRunning = true
                    local count = math.random(CONFIG.AUTO_ADD_MIN, CONFIG.AUTO_ADD_MAX)
                    for i = 1, count do
                        if not mockState.active or not CONFIG.AUTO_ADD_ENABLED then break end
                        if #mockState.trade.recipient_offer.items < 18 then
                            local petName = getRandomHighValuePet()
                            local flags = generateRandomPetProperties()
                            addPetToPartnerOffer(petName, flags)
                            task.wait(getSmartDelay())
                        end
                    end
                    mockState.autoAddRunning = false
                end
            end
        end)
        
        if HintApp then
            HintApp:hint({ text = 'Auto Add enabled!', length = 2, overridable = true })
        end
    else
        CONFIG.AUTO_ADD_ENABLED = false
        autoAddToggle.BackgroundColor3 = Color3.fromRGB(100, 60, 60)
        autoAddToggle.Text = '🔴 AUTO ADD OFF'
        ats.Color = Color3.fromRGB(255, 100, 100)
        if HintApp then
            HintApp:hint({ text = 'Auto Add disabled!', length = 2, overridable = true })
        end
    end
end)

